    {
      "key": "lead",
      "type": "lead",
      "title": "ABOUT",
      "text": "**synthwerk-vision** gives one image a label and the label's place in a topic tree (hut → building → building and structure). A label is a text, so a new label needs no training. It does one thing, on CPU, and does not want to talk about it."
    },
    {
      "key": "what",
      "type": "notes",
      "title": "WHAT IT DOES",
      "columns": 2,
      "items": [
        {
          "lead": "Open vocabulary",
          "text": "A label is a text, so a new label needs no training or new weights."
        },
        {
          "lead": "A topic tree",
          "text": "Every label has a place: `beagle → dog → mammal → animal`."
        },
        {
          "lead": "Runs on CPU",
          "text": "ONNX Runtime, about 35 ms per image on an M-series Mac. No GPU, no external API."
        },
        {
          "lead": "Eval gate",
          "text": "Scores **93.1 %** root-topic accuracy on 58 frozen photos. CI fails below 90 %."
        }
      ]
    },
    {
      "key": "setup",
      "type": "commands",
      "title": "WHAT EACH STEP DOES",
      "rows": [
        {
          "cmd": "uv sync",
          "text": "Install runtime + dev dependencies from `uv.lock`."
        },
        {
          "cmd": "uv run python scripts/fetch_model.py",
          "text": "Both backends, pinned + SHA-256 verified (~1.5 GB). Or one: `fetch_model.py siglip` or `fetch_model.py mobilenet`."
        },
        {
          "cmd": "uv run uvicorn synthwerk_vision.main:create_app --factory --reload",
          "text": "Start the API. Open `http://localhost:8000/docs`."
        },
        {
          "cmd": "curl -F \"image=@hut.jpg\" http://localhost:8000/v1/classifications",
          "text": "Classify one image."
        }
      ]
    },
    {
      "key": "startnotes",
      "type": "notes",
      "columns": 2,
      "items": [
        {
          "lead": "Needs",
          "text": "[uv](https://docs.astral.sh/uv/) and Python 3.12."
        },
        {
          "lead": "First start",
          "text": "Embeds all label texts once (about 9 s on an M-series CPU) and caches them in `models/label_cache/`. Later starts take about 0.5 s."
        }
      ]
    },
    {
      "key": "docker",
      "type": "terminal",
      "title": "WITH DOCKER · WEIGHTS AND LABEL CACHE AT BUILD TIME",
      "lines": [
        "# SigLIP (default)",
        "$ docker build -t synthwerk-vision .",
        "# MobileNet: 14 MB of weights",
        "$ docker build --build-arg BACKEND=mobilenet -t synthwerk-vision:small .",
        "$ docker run -p 8000:8000 -v synthwerk-vision-uploads:/data/uploads synthwerk-vision"
      ]
    },
    {
      "key": "how",
      "type": "notes",
      "title": "READ THE ANSWER",
      "items": [
        {
          "lead": "Scores",
          "text": "The model (SigLIP 2, ONNX, fp32) scores every label. The score of a topic is the sum of its labels."
        },
        {
          "lead": "Response",
          "text": "The best label, its topic path, the top-k labels and the topics."
        },
        {
          "lead": "Uncertain",
          "text": "`uncertain` turns true when the root topic score is too low. Read it before you trust the answer."
        }
      ]
    },
    {
      "key": "api",
      "type": "commands",
      "title": "THE API",
      "rows": [
        {
          "cmd": "GET /health",
          "text": "Liveness, and whether the model is loaded."
        },
        {
          "cmd": "POST /v1/classifications",
          "text": "Classify an image (not stored)."
        },
        {
          "cmd": "POST /v1/images",
          "text": "Store an image, return its id."
        },
        {
          "cmd": "POST /v1/labels",
          "text": "Admin. Needs `SYNTHWERK_VISION_ADMIN_TOKEN`."
        },
        {
          "cmd": "GET /v1/labels",
          "text": "Admin. Needs `SYNTHWERK_VISION_ADMIN_TOKEN`."
        },
        {
          "cmd": "DELETE /v1/labels/{id}",
          "text": "Admin. Needs `SYNTHWERK_VISION_ADMIN_TOKEN`."
        },
        {
          "cmd": "POST /v1/feedback",
          "text": "Admin. Needs `SYNTHWERK_VISION_ADMIN_TOKEN`."
        }
      ]
    },
    {
      "key": "backends",
      "type": "commands",
      "title": "TWO BACKENDS",
      "rows": [
        {
          "cmd": "siglip",
          "text": "**Default.** SigLIP 2 base/16, open vocabulary, ~1.5 GB of weights."
        },
        {
          "cmd": "mobilenet",
          "text": "MobileNetV2-12, 1000 ImageNet classes, 14 MB of weights."
        }
      ]
    },
    {
      "key": "config",
      "type": "commands",
      "title": "CONFIGURATION",
      "rows": [
        {
          "cmd": "SYNTHWERK_VISION_",
          "text": "Every setting is an env var with this prefix. See `.env.example`."
        },
        {
          "cmd": "AURORAE_, AURORA_",
          "text": "Old prefixes. They are ignored. Rename them in every `.env` and deployment."
        }
      ]
    },
