# All settings but the widget token settings are optional; defaults live in src/synthwerk_vision/platform/config.py.
# Shared platform setting (no service prefix): local, ci, dev, stg or prd.
SYNTHWERK_PLATFORM_ENV=local
# DEBUG, INFO, WARN or ERROR.
SYNTHWERK_VISION_LOG_LEVEL=INFO
# json (default) or console. console is used only when SYNTHWERK_PLATFORM_ENV=local.
SYNTHWERK_VISION_LOG_FORMAT=json
# Git commit shown by /readyz. The image sets it from the COMMIT build argument.
# SYNTHWERK_VISION_COMMIT=0000000
SYNTHWERK_VISION_CORS_ORIGINS=["http://localhost:5173"]
SYNTHWERK_VISION_UPLOAD_DIR=uploads
# Quota for POST /v1/images in UPLOAD_DIR; when reached, uploads answer 507.
SYNTHWERK_VISION_UPLOAD_QUOTA_BYTES=1073741824
SYNTHWERK_VISION_UPLOAD_QUOTA_FILES=10000
SYNTHWERK_VISION_DATA_DIR=data
# SYNTHWERK_VISION_ADMIN_TOKEN=  # set to enable /v1/labels and /v1/feedback
# Widget token (#76): required, or the service does not start. The issuer must equal
# SYNTHWERK_IDENTITY_WIDGET_ISSUER of synthwerk-identity.
SYNTHWERK_VISION_OIDC_ISSUER=http://identity.localhost:8080
SYNTHWERK_VISION_JWKS_URL=http://identity.localhost:8080/.well-known/jwks.json
# Accepted aud values, comma-separated.
SYNTHWERK_VISION_OIDC_AUDIENCE=synthwerk-api
# Local development without identity only (env local or ci): no token on classify and upload.
# SYNTHWERK_VISION_AUTH_DISABLED=true
SYNTHWERK_VISION_MAX_UPLOAD_BYTES=5242880
SYNTHWERK_VISION_MAX_IMAGE_PIXELS=40000000
SYNTHWERK_VISION_BACKEND=siglip
SYNTHWERK_VISION_SIGLIP_DIR=models/siglip2-base-patch16-224
SYNTHWERK_VISION_LABEL_CACHE_DIR=models/label_cache
# mobilenet backend only:
# SYNTHWERK_VISION_MODEL_PATH=models/mobilenetv2-12.onnx
# SYNTHWERK_VISION_TAXONOMY_PATH=my-taxonomy.yaml
# Threads per ONNX Runtime session (0 = ORT default). Spinning is always off.
SYNTHWERK_VISION_ORT_THREADS=0
SYNTHWERK_VISION_TOP_K=5
SYNTHWERK_VISION_TOPIC_MIN_SCORE=0.05
SYNTHWERK_VISION_UNCERTAIN_BELOW=0.5

# OpenTelemetry (OTel spec names, no prefix). Read from the process environment, not from
# .env. Without OTEL_EXPORTER_OTLP_ENDPOINT no exporter starts and one WARN line is logged.
# OTEL_SERVICE_NAME=synthwerk-vision
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=synthwerk,deployment.environment.name=local
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
